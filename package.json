{
  "name": "stairslife-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint",
    "check": "npm run lint && npm run lint:css && tsc --noEmit",
    "lint:css": "node scripts/check-css-tokens.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verifikasi": "npm run check && npm run test && npm run build",
    "prebuild": "node scripts/cek-produksi.mjs",
    "cek:produksi": "node scripts/cek-produksi.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.42.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@emnapi/core": "1.10.0",
    "@emnapi/runtime": "1.10.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
