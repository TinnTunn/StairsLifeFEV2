# Alamat backend NestJS. Prefix /api/v1 wajib ikut, tanpa garis miring di akhir.
# Produksi: alamat Railway atau domain API sendiri, dan harus https.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Alamat situs ini sendiri. Dipakai metadata Open Graph, sitemap.xml, dan
# robots.txt, jadi kalau salah, tautan yang dibagikan dan hasil pencarian ikut
# salah. Tanpa garis miring di akhir.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# 1 = pakai data contoh tanpa backend, dan tampilkan penanda "data contoh".
# 0 = pakai API sungguhan.
# Saat 0, isi FRONTEND_URL di backend dengan alamat frontend ini, karena
# whitelist CORS mode dev hanya mengenal port 5173 dan 5500.
NEXT_PUBLIC_USE_MOCK=1

# Ketiganya dibekukan ke dalam bundel saat build, bukan dibaca saat dijalankan.
# Mengubahnya di Vercel mengharuskan build ulang. scripts/cek-produksi.mjs
# menghentikan build kalau salah satunya kosong atau masih menunjuk localhost.
