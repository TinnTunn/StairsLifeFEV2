{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Bricolage Grotesque|Archivo))/i]",
        "message": "Font not provided by the design system. Available: Bricolage Grotesque, Archivo."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|src|size|verified|online|shape|key|ref|className|style|children|id|type|value|defaultValue|checked|defaultChecked|placeholder|disabled|readOnly|required|autoComplete|autoFocus|maxLength|minLength|min|max|step|rows|cols|inputMode|pattern|form|multiple|accept|href|target|rel|title|role|tabIndex|htmlFor|hidden|onClick|onChange|onInput|onBlur|onFocus|onKeyDown|onKeyUp|onSubmit|onMouseEnter|onMouseLeave|onMouseDown|onMouseUp|aria-[a-z]+|data-[a-z-]+)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, src, size, verified, online, shape."
